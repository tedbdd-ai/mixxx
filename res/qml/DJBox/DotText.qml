import QtQuick
import "."

// Punktmatrix-Anzeige (5×7) für BPM, Tonart und Zeit. Bewusst ohne Schriftdatei.
Canvas {
    id: root

    property color color: Style.fg
    property real dot: 3
    readonly property var glyphs: ({
            "0": [14, 17, 19, 21, 25, 17, 14],
            "1": [4, 12, 4, 4, 4, 4, 14],
            "2": [14, 17, 1, 2, 4, 8, 31],
            "3": [31, 2, 4, 2, 1, 17, 14],
            "4": [2, 6, 10, 18, 31, 2, 2],
            "5": [31, 16, 30, 1, 1, 17, 14],
            "6": [6, 8, 16, 30, 17, 17, 14],
            "7": [31, 1, 2, 4, 8, 8, 8],
            "8": [14, 17, 17, 14, 17, 17, 14],
            "9": [14, 17, 17, 15, 1, 2, 12],
            "A": [14, 17, 17, 31, 17, 17, 17],
            "B": [30, 17, 17, 30, 17, 17, 30],
            "C": [14, 17, 16, 16, 16, 17, 14],
            "D": [30, 17, 17, 17, 17, 17, 30],
            "E": [31, 16, 16, 30, 16, 16, 31],
            "F": [31, 16, 16, 30, 16, 16, 16],
            "G": [14, 17, 16, 23, 17, 17, 15],
            "H": [17, 17, 17, 31, 17, 17, 17],
            "I": [14, 4, 4, 4, 4, 4, 14],
            "J": [7, 2, 2, 2, 2, 18, 12],
            "K": [17, 18, 20, 24, 20, 18, 17],
            "L": [16, 16, 16, 16, 16, 16, 31],
            "M": [17, 27, 21, 21, 17, 17, 17],
            "N": [17, 17, 25, 21, 19, 17, 17],
            "O": [14, 17, 17, 17, 17, 17, 14],
            "P": [30, 17, 17, 30, 16, 16, 16],
            "Q": [14, 17, 17, 17, 21, 18, 13],
            "R": [30, 17, 17, 30, 20, 18, 17],
            "S": [15, 16, 16, 14, 1, 1, 30],
            "T": [31, 4, 4, 4, 4, 4, 4],
            "U": [17, 17, 17, 17, 17, 17, 14],
            "V": [17, 17, 17, 17, 17, 10, 4],
            "W": [17, 17, 17, 21, 21, 21, 10],
            "X": [17, 17, 10, 4, 10, 17, 17],
            "Y": [17, 17, 17, 10, 4, 4, 4],
            "Z": [31, 1, 2, 4, 8, 16, 31],
            "m": [0, 0, 26, 21, 21, 21, 21],
            "b": [16, 16, 30, 17, 17, 17, 30],
            "#": [10, 10, 31, 10, 31, 10, 10],
            ".": [0, 0, 0, 0, 0, 12, 12],
            ":": [0, 12, 12, 0, 12, 12, 0],
            "-": [0, 0, 0, 14, 0, 0, 0],
            "+": [0, 4, 4, 31, 4, 4, 0],
            "%": [24, 25, 2, 4, 8, 19, 3],
            " ": [0, 0, 0, 0, 0, 0, 0]
        })
    property string text: ""

    height: 7 * dot
    width: Math.max(1, text.length * 6 - 1) * dot

    onColorChanged: requestPaint()
    onPaint: {
        const ctx = getContext("2d");
        ctx.reset();
        ctx.fillStyle = root.color;
        const d = root.dot, r = d * 0.42;
        for (let i = 0; i < root.text.length; i++) {
            const ch = root.text[i], rows = root.glyphs[ch] || root.glyphs[ch.toUpperCase()] || root.glyphs["-"];
            for (let y = 0; y < 7; y++) {
                for (let x = 0; x < 5; x++) {
                    if (rows[y] & (1 << (4 - x))) {
                        ctx.beginPath();
                        ctx.arc((i * 6 + x + 0.5) * d, (y + 0.5) * d, r, 0, Math.PI * 2);
                        ctx.fill();
                    }
                }
            }
        }
    }
    onTextChanged: requestPaint()
}
